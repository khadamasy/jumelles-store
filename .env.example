# ========================================================
# VARIABLES D'ENVIRONNEMENT - JUMELLES STORE
# Copiez ce fichier en ".env" et REMPLACEZ toutes les valeurs "CHANGEZ_MOI".
# Ne publiez jamais votre fichier .env (il est exclu de Git).
# ========================================================

# Sécurité de l'Espace Gérance (/admin)
ADMIN_PASSWORD=CHANGEZ_MOI_mot_de_passe_long_12_caracteres_minimum
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGEZ_MOI_chaine_aleatoire_de_64_caracteres_minimum
# Domaine(s) public(s) du site, séparés par des virgules
ALLOWED_ORIGINS=https://www.votre-domaine.sn
# Mettre "true" si l'API est derrière un proxy (Nginx, Render, Railway...)
TRUST_PROXY=false

# Base de Données PostgreSQL
POSTGRES_USER=jumelles_admin
POSTGRES_PASSWORD=CHANGEZ_MOI
POSTGRES_DB=jumelles_db

# Authentification Keycloak (optionnel) : désactivée tant que KEYCLOAK_ENABLED n'est pas "true"
KEYCLOAK_ENABLED=false
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEZ_MOI
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=jumelles-store
KEYCLOAK_CLIENT_ID=jumelles-backend

# Stockage MinIO S3
MINIO_ROOT_USER=jumelles_minio
MINIO_ROOT_PASSWORD=CHANGEZ_MOI_secret_minio_16_caracteres_minimum
MINIO_ACCESS_KEY=jumelles_minio
MINIO_SECRET_KEY=CHANGEZ_MOI_secret_minio_16_caracteres_minimum
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
# Optionnel : laisser vide pour servir les photos sur le même domaine (/jumelles-products/...).
# À renseigner uniquement si les photos sont servies par un CDN ou un domaine dédié.
MINIO_PUBLIC_URL=
MINIO_BUCKET_PRODUCTS=jumelles-products
MINIO_BUCKET_INVOICES=jumelles-invoices

# Ports Serveurs
PORT=4000
FRONTEND_PORT=3000

# HTTPS automatique (docker compose --profile https up -d --build)
# Domaine du site, déjà dirigé vers l'adresse IP du serveur
SITE_DOMAIN=jumelles-store.sn
PUBLIC_SITE_URL=https://jumelles-store.sn
# 127.0.0.1 avec HTTPS (accès uniquement via Caddy) ; 0.0.0.0 sans HTTPS
FRONTEND_BIND=127.0.0.1

# Annulation automatique des commandes non confirmées (heures ; 0 = désactivée)
ORDER_PENDING_TTL_HOURS=48
